<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="DataBaseConnection" connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;Integrated Security=True;"/>
	</connectionStrings>
	<appSettings>
		<add key="BackupFolder" value="C:\DatabaseBackups" />
		<add key="LogFolder" value="C:\DatabaseBackups\Logs" />
		<add key="BackupIntervalMinutes" value="60" />
	</appSettings>
</configuration>
